<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.ReliableAlarmV10" parent="Theme.MaterialComponents.DayNight.Bridge">
        <item name="colorPrimary">@color/main_blue</item>
        <item name="colorOnPrimary">@color/black</item>
        <item name="colorPrimaryDark">@color/blue_darker</item>

        <item name="android:colorBackground">@color/backgroundMain</item>
        <item name="colorOnBackground">@color/white</item>
        <item name="colorScrimBackground">@color/scrimBackground</item>

        <item name="colorSecondary">@color/white</item>
        <item name="colorOnSecondary">@color/black</item>

        <item name="android:statusBarColor">@color/blue_darker</item>

        <item name="colorError">@color/bad_info</item>
        <item name="colorOnError">@color/black</item>

        <item name="colorSurface">@color/grey</item>
        <item name="colorOnSurface">@color/white</item>

        <item name="android:windowBackground">@color/backgroundMain</item>

        <item name="colorControlNormal">@color/white</item>
        <item name="toolbarStyle">@style/CustomToolbar</item>
    </style>

    <style name="CustomToolbar" parent="Widget.MaterialComponents.Toolbar">
        <item name="titleTextColor">@color/white</item>
    </style>
</resources>